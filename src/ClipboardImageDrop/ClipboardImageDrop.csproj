<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <!-- Package & Assembly Metadata -->
    <Version>1.0.0</Version>
    <AssemblyTitle>ClipboardImageDrop</AssemblyTitle>
    <Product>Clipboard Image Drop</Product>
    <Description>Lightweight Windows tray utility that seamlessly allows pasting clipboard images directly into Windows Explorer folders and Desktop as PNG files.</Description>
    <Authors>Mykola Kushch</Authors>
    <RepositoryUrl>https://github.com/mykolakushch/ClipboardImageDrop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
